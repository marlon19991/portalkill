; Engine configuration file.
config_version=5

[application]

config/name="PortalKill"
config/description="Hordas, portales y armas elementales."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.02, 0.04, 1)
boot_splash/show_image=false

[autoload]

Events="*res://src/core/events.gd"
Game="*res://src/core/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=900.0

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="oneway"
2d_physics/layer_3="player"
2d_physics/layer_4="enemies"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.04, 1)
